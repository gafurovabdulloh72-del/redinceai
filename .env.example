# SQLite fayl (lokal). Vercel/Turso'da: libsql://xxx-user.turso.io + token
DATABASE_URL=file:./data/redince.db
# Turso ishlatilsa (Vercel Marketplace integratsiyasi TURSO_DATABASE_URL / TURSO_AUTH_TOKEN ni o'zi qo'yadi):
# DATABASE_AUTH_TOKEN=
# Vercel Blob (rasm yuklash) — Vercel Storage → Blob yaratilganda BLOB_READ_WRITE_TOKEN avtomatik qo'shiladi

# JWT sessiya uchun maxfiy kalit (kamida 32 belgi). `openssl rand -base64 48` bilan yarating.
# Productionda MAJBURIY: bo'sh, qisqa yoki namunaviy ("change-me…") qiymat rad etiladi (Turso tokeni bo'lsa
# undan kalit hosil qilinadi va ogohlantiriladi). Dev'da bo'sh qoldirsangiz vaqtinchalik kalit ishlatiladi.
# Diqqat: 2FA (TOTP) sirlari va payout rekvizitlari ham shu kalitdan (HKDF) shifrlanadi — almashtirilsa,
# barcha sessiyalar bekor bo'ladi, 2FA yoqilgan foydalanuvchilar esa zaxira kodi bilan kirib, 2FA'ni qayta sozlashi kerak.
AUTH_SECRET=

# Admin foydalanuvchi (seed paytida yaratiladi). Productionda ADMIN_PASSWORD MAJBURIY — bo'sh yoki
# "admin12345" bo'lsa seed to'xtaydi. Dev'da bo'sh qoldirilsa admin12345.
ADMIN_EMAIL=admin@redince.uz
ADMIN_PASSWORD=
# Demo hisoblar (mijoz@ / mutaxassis@redince.uz) paroli. Bo'sh bo'lsa: dev'da demo12345, productionda tasodifiy
# DEMO_PASSWORD=

# Yuklangan rasmlar papkasi (Railway Volume uchun: /data/uploads). Bo'sh bo'lsa public/uploads
# UPLOAD_DIR=/data/uploads

# Productionda: boshlanishda bazani seed qilish (faqat bo'sh bo'lsa). 0 = o'chirish
# SEED_ON_START=1

# Sayt manzili — productionda MAJBURIY: parol tiklash havolasi, to'lov qaytish URL'lari, sitemap/OG shu asosda.
# Ustuvorlik: SITE_URL → NEXT_PUBLIC_SITE_URL → Vercel production (VERCEL_PROJECT_PRODUCTION_URL) → Railway
# (RAILWAY_PUBLIC_DOMAIN). Sozlanmagan bo'lsa productionda parol tiklash / tasdiqlash xati YUBORILMAYDI
# (Host sarlavhasidan olinmaydi — reset-link poisoning) va konsolga xato yoziladi.
# NEXT_PUBLIC_SITE_URL=https://kasb-egalari.up.railway.app
# SITE_URL=https://redince.uz
# Proksi sarlavhalari: X-Forwarded-Host/Proto faqat ishonchli proksi (Nginx/Cloudflare) ularni qayta yozsa — 1 qo'ying.
# Vercel/Railway'da avtomatik yoqiladi. Lokal/to'g'ridan-to'g'ri ulanishda bo'sh qoldiring (faqat Host ishlatiladi).
# TRUST_PROXY_HOST=1
# X-Forwarded-For'da o'ngdan nechta qiymat ishonchli proksi qo'shgan (rate limit IP'si shundan olinadi). Standart: 1
# TRUSTED_PROXY_HOPS=1

# ---------- Xavfsizlik / auth ----------
# Demo hisoblar paneli (/auth/kirish) — faqat 1 bo'lsa ko'rinadi. Productionda o'chiring!
NEXT_PUBLIC_DEMO_ACCOUNTS=0
# Parol tiklash, email tasdiqlash va bildirishnoma xatlari (Resend). Ikkalasi ham bo'lmasa dev'da xat server konsoliga chiqadi.
# Bildirishnoma xatlaridagi havolalar SITE_URL / NEXT_PUBLIC_SITE_URL asosida tuziladi (productionda sozlanmasa — havolasiz).
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="Redince <no-reply@redince.uz>"

# ---------- To'lovlar (eskrou) ----------
# Payme Merchant API. PAYME_TEST=1 bo'lsa test kassasi (checkout.test.paycom.uz) va PAYME_TEST_KEY ishlatiladi
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_TEST_KEY=
# PAYME_TEST=1
# Click SHOP API (Prepare/Complete URL: https://<sayt>/api/payments/click)
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# Qo'lda o'tkazma (karta raqami ko'rsatiladi, admin tasdiqlaydi). Bo'sh bo'lsa bu usul chiqmaydi
# PLATFORM_CARD="8600 **** **** 1234"
# PLATFORM_CARD_NAME="Redince MChJ"
# Qaytish (return) havolalari uchun sayt manzili (yuqoridagi NEXT_PUBLIC_SITE_URL ham shu)

# ---------- Fon vazifalari ----------
# Kunlik fon vazifasi (/api/cron/daily): Authorization: Bearer <CRON_SECRET>. Vercel CRON_SECRET o'rnatilgan bo'lsa uni o'zi yuboradi; bo'sh bo'lsa faqat x-vercel-cron sarlavhasi qabul qilinadi
CRON_SECRET=
