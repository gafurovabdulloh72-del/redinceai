# SQLite fayl (lokal). Vercel/Turso'da: libsql://xxx-user.turso.io + token
DATABASE_URL=file:./data/redince.db
# Turso ishlatilsa (Vercel Marketplace integratsiyasi TURSO_DATABASE_URL / TURSO_AUTH_TOKEN ni o'zi qo'yadi):
# DATABASE_AUTH_TOKEN=
# Vercel Blob (rasm yuklash) — Vercel Storage → Blob yaratilganda BLOB_READ_WRITE_TOKEN avtomatik qo'shiladi

# JWT sessiya uchun maxfiy kalit (kamida 32 belgi). `openssl rand -base64 48` bilan yarating.
AUTH_SECRET=change-me-to-a-long-random-secret-string-please

# Admin foydalanuvchi (seed paytida yaratiladi)
ADMIN_EMAIL=admin@redince.uz
ADMIN_PASSWORD=admin12345

# Yuklangan rasmlar papkasi (Railway Volume uchun: /data/uploads). Bo'sh bo'lsa public/uploads
# UPLOAD_DIR=/data/uploads

# Productionda: boshlanishda bazani seed qilish (faqat bo'sh bo'lsa). 0 = o'chirish
# SEED_ON_START=1

# Sayt manzili (sitemap/robots uchun)
# NEXT_PUBLIC_SITE_URL=https://kasb-egalari.up.railway.app

# ---------- Xavfsizlik / auth ----------
# Demo hisoblar paneli (/auth/kirish) — faqat 1 bo'lsa ko'rinadi. Productionda o'chiring!
NEXT_PUBLIC_DEMO_ACCOUNTS=0
# Parol tiklash xatlari (Resend). Ikkalasi ham bo'lmasa dev'da havola server konsoliga chiqadi
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="Redince <no-reply@redince.uz>"

# ---------- To'lovlar (eskrou) ----------
# Payme Merchant API. PAYME_TEST=1 bo'lsa test kassasi (checkout.test.paycom.uz) va PAYME_TEST_KEY ishlatiladi
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_TEST_KEY=
# PAYME_TEST=1
# Click SHOP API (Prepare/Complete URL: https://<sayt>/api/payments/click)
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# Qo'lda o'tkazma (karta raqami ko'rsatiladi, admin tasdiqlaydi). Bo'sh bo'lsa bu usul chiqmaydi
# PLATFORM_CARD="8600 **** **** 1234"
# PLATFORM_CARD_NAME="Redince MChJ"
# Qaytish (return) havolalari uchun sayt manzili (yuqoridagi NEXT_PUBLIC_SITE_URL ham shu)
