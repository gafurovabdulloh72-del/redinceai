{
  "name": "redince",
  "version": "0.1.0",
  "private": true,
  "description": "Redince — O'zbekiston bo'ylab videograf, montajor va dizaynerlarni topish platformasi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "rm -f data/redince.db && npm run db:push && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "start:railway": "sh scripts/start.sh",
    "db:seed:ifempty": "tsx src/lib/db/seed.ts --if-empty",
    "vercel-build": "node scripts/db-prepare.mjs && next build",
    "db:prepare": "node scripts/db-prepare.mjs",
    "test:smoke": "node --test scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.15.0",
    "@livekit/components-react": "^2.9.0",
    "@livekit/components-styles": "^1.1.6",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.0",
    "framer-motion": "^12.0.0",
    "jose": "^6.0.0",
    "livekit-client": "^2.9.5",
    "lucide-react": "^0.500.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
