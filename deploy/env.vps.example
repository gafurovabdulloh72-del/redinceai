# VPS uchun .env namunasi — serverda repo ildiziga nusxalang: cp deploy/env.vps.example .env
# To'ldirish tartibi docs/DEPLOY-VPS.md da qadam-baqadam yozilgan.

# ---------- Domen (Caddy avto-SSL shu nom uchun sertifikat oladi) ----------
SITE_DOMAIN=kasbegalari.uz
SITE_URL=https://kasbegalari.uz

# Avtomatik RU tarjima (lug'atda yo'q yangi UI matnlari — Gemini, Google AI Studio bepul kaliti; bo'lmasa faqat lug'at)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---------- Majburiy sirlar ----------
# openssl rand -base64 48
AUTH_SECRET=
# Kontaktlarni (telefon/Telegram/Instagram) bazada shifrlash kaliti — ixtiyoriy, bo'lmasa AUTH_SECRET ishlatiladi.
# DIQQAT: kalit o'zgarsa shifrlangan kontaktlar o'qilmaydi — ko'chishda aynan ko'chiring (qaytarish: scripts/seal-contacts.ts --unseal)
DATA_ENCRYPTION_KEY=
# Admin hisobi (birinchi ishga tushishda yaratiladi)
ADMIN_EMAIL=admin@kasbegalari.uz
ADMIN_PASSWORD=
# openssl rand -hex 32 — kunlik cron so'rovini himoyalaydi
CRON_SECRET=

# ---------- Baza va fayllar (docker-compose o'zi beradi — tegmang) ----------
# DATABASE_URL=file:/data/redince.db
# UPLOAD_DIR=/data/uploads

# ---------- Cloudflare R2 (fayllar — rasm/hujjat/video) ----------
# Barcha 5 qiymat TO'LIQ bo'lsa yangi yuklamalar R2'ga boradi; bo'sh qoldirsangiz fayllar serverda
# (/data/uploads) saqlanadi — sayt R2'siz ham to'liq ishlaydi. Qadamlar: docs/DEPLOY-VPS.md "R2 yoqish".
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=kasbegalari-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE=https://media.kasbegalari.uz

# ---------- Email (Resend) ----------
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="Kasb Egalari <no-reply@kasbegalari.uz>"

# ---------- Telegram bot (docs/DEPLOY.md §11) ----------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_REQUIRED_CHANNEL=@kasbegalari   # majburiy obuna (bot kanalga admin bo'lsin); bo'sh — o'chiq
# TELEGRAM_REQUIRED_CHANNEL_URL=

# ---------- To'lovlar ----------
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# PLATFORM_CARD="8600 **** **** 1234"
# PLATFORM_CARD_NAME="Kasb Egalari"

# ---------- Google bilan kirish (redirect: https://<domen>/api/auth/google/callback) ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------- Jonli efir / qo'ng'iroqlar (LiveKit Cloud) ----------
# LIVEKIT_URL=wss://<loyiha>.livekit.cloud
# NEXT_PUBLIC_LIVEKIT_URL=wss://<loyiha>.livekit.cloud
# Admin «Tizim holati»dagi LiveKit sarfi ko'rsatkichi uchun oylik limit (GB). Bepul reja ~50; pullik rejada oshiring
# LIVEKIT_MONTHLY_GB=50
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---------- Web Push (node scripts/gen-vapid.mjs) ----------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@kasbegalari.uz

# ---------- Telegram ichida to'lov (ixtiyoriy) ----------
# TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# ---------- Xavfsizlik ----------
# ADMIN_REQUIRE_2FA=1
# Cloudflare proksi yoqilgan bo'lsa (haqiqiy IP CF-Connecting-IP sarlavhasidan olinadi):
# TRUST_CLOUDFLARE=1

# ---------- Litestream backup (ixtiyoriy, --profile backup) ----------
# LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_BUCKET=kasbegalari-backup
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# ---------- Boshqa ----------
# Bo'sh serverda demo ma'lumot yaratadi. Turso'dan ko'chirsangiz — 0 qiling!
SEED_ON_START=1
NEXT_PUBLIC_DEMO_ACCOUNTS=0
